<?xml version="1.0" encoding="utf-8" ?>
<!--
  Bluetooth SDP Record for combined Keyboard + Mouse HID device.
  Used by BlueZ when registering the HID profile.
  Conforms to HID Profile Specification 1.1.1
-->
<record>
  <!-- Service class list: HID -->
  <attribute id="0x0001">
    <sequence>
      <uuid value="0x1124"/>
    </sequence>
  </attribute>

  <!-- Protocol descriptor list: L2CAP + HID Control -->
  <attribute id="0x0004">
    <sequence>
      <sequence>
        <uuid value="0x0100"/>
        <uint16 value="0x0011"/>  <!-- PSM 17: HID Control -->
      </sequence>
      <sequence>
        <uuid value="0x0011"/>
      </sequence>
    </sequence>
  </attribute>

  <!-- Browse group list -->
  <attribute id="0x0005">
    <sequence>
      <uuid value="0x1002"/>
    </sequence>
  </attribute>

  <!-- Language base attribute list -->
  <attribute id="0x0006">
    <sequence>
      <uint16 value="0x656e"/>
      <uint16 value="0x006a"/>
      <uint16 value="0x0100"/>
    </sequence>
  </attribute>

  <!-- Additional protocol descriptor list: L2CAP + HID Interrupt -->
  <attribute id="0x000d">
    <sequence>
      <sequence>
        <sequence>
          <uuid value="0x0100"/>
          <uint16 value="0x0013"/>  <!-- PSM 19: HID Interrupt -->
        </sequence>
        <sequence>
          <uuid value="0x0011"/>
        </sequence>
      </sequence>
    </sequence>
  </attribute>

  <!-- Service name -->
  <attribute id="0x0100">
    <text value="BT-KBM Keyboard+Mouse"/>
  </attribute>

  <!-- Service description -->
  <attribute id="0x0101">
    <text value="Raspberry Pi Bluetooth HID Keyboard and Mouse"/>
  </attribute>

  <!-- Provider name -->
  <attribute id="0x0102">
    <text value="BT-KBM"/>
  </attribute>

  <!-- HID Attributes -->
  <!-- HID Release Number: 1.1.1 -->
  <attribute id="0x0200">
    <uint16 value="0x0101"/>
  </attribute>

  <!-- HID Parser Version: 1.1.1 -->
  <attribute id="0x0201">
    <uint16 value="0x0111"/>
  </attribute>

  <!-- HID Device Subclass: Keyboard (0x40) + Mouse (0x80) = combo (0xC0) -->
  <attribute id="0x0202">
    <uint8 value="0xC0"/>
  </attribute>

  <!-- HID Country Code: 0 = not localized -->
  <attribute id="0x0203">
    <uint8 value="0x00"/>
  </attribute>

  <!-- HID Virtual Cable: false -->
  <attribute id="0x0204">
    <boolean value="false"/>
  </attribute>

  <!-- HID Reconnect Initiate: true (device reconnects on its own) -->
  <attribute id="0x0205">
    <boolean value="true"/>
  </attribute>

  <!--
    HID Descriptor List
    Contains the HID Report Descriptor (keyboard + mouse + consumer).
    Report IDs:
      1 = Keyboard  (8 bytes: modifier, reserved, 6x keycode)
      2 = Mouse     (4 bytes: buttons, X, Y, wheel)
      3 = Consumer  (2 bytes: bitmask for media keys)
  -->
  <attribute id="0x0206">
    <sequence>
      <sequence>
        <uint8 value="0x22"/>
        <text encoding="hex" value="
          05010906a101850175019508050719e029e781029501750881017506950805070719002965810026650075089506050719002965800000c0
          050109020a101850209010a000850209010c009050919012903150025017501950381029501750581017508950305010930093109381581257f810600c0c0
          050c0901a10185031500250175019510098b509b609b709cd09e209e909ea09b809838409b409438410094210092110091510910c810681028102c0
        "/>
      </sequence>
    </sequence>
  </attribute>

  <!-- HID LANGID Base List -->
  <attribute id="0x0207">
    <sequence>
      <sequence>
        <uint16 value="0x0409"/>
        <uint16 value="0x0100"/>
      </sequence>
    </sequence>
  </attribute>

  <!-- HID Battery Power: false (USB powered via Pi) -->
  <attribute id="0x0209">
    <boolean value="false"/>
  </attribute>

  <!-- HID Remote Wake: true -->
  <attribute id="0x020A">
    <boolean value="true"/>
  </attribute>

  <!-- HID Profile Version: 1.1.1 -->
  <attribute id="0x020B">
    <uint16 value="0x0111"/>
  </attribute>

  <!-- HID Supervision Timeout: 0xc80 (3200ms) -->
  <attribute id="0x020C">
    <uint16 value="0x0c80"/>
  </attribute>

  <!-- HID Normally Connectable: true -->
  <attribute id="0x020D">
    <boolean value="true"/>
  </attribute>

  <!-- HID Boot Device: true (supports boot protocol) -->
  <attribute id="0x020E">
    <boolean value="true"/>
  </attribute>
</record>
